{
  "layer": "bottom",
  "margin-top": 0,
  "margin-bottom": 0,
  "margin-left": 0,
  "margin-right": 0,
  "modules-left": ["hyprland/workspaces"],
  // "modules-center": ["hyprland/window"],
  "modules-center": ["clock", "hyprland/window"],
  "modules-right": [
    // "tray",
    "idle_inhibitor",
    "pulseaudio",
    "network",
    "temperature",
    "cpu",
    "memory",
    "custom/power"
  ],
  "hyprland/window": {
    "max-length": 50
  },
  "tray": {
    "hide-if-empty": true
  },
  "clock": {
    "format-alt": "{:%a, %d. %b  %H:%M}"
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "󰤨",
      "deactivated": "󰤩"
    },
    "on-click-right": "hyprlock"
  },
  "pulseaudio": {
    "format": " {volume}%",
    "format-muted": " Muted"
  },
  "network": {
    "format-ethernet": "󰍛 {ifname} {ipaddr}",
    "format-disconnected": "󰍛 Disconnected",
    "format-error": "󰍛 Error"
  },
  "temperature": {
    // "thermal-zone": 2,
    "thermal-zone": 1,
    "format": "󰔏 {temperatureC}°C",
    "max": 80,
    "critical": 90
  },
  "cpu": {
    "format": " {usage}%"
  },
  "memory": {
    "format": "󰍛 {used} GiB"
  },
  "custom/power": {
    "format": "",
    "tooltip": "Power Menu",
    "on-click": "wlogout"
  }
}
