{
  "layer": "bottom",
  "margin-top": 0,
  "margin-bottom": 0,
  "margin-left": 0,
  "margin-right": 0,
  "modules-left": ["hyprland/workspaces"],
  // "modules-center": ["hyprland/window"],
  "modules-center": ["clock", "hyprland/window"],
  "modules-right": [
    // "tray",
    "idle_inhibitor",
    "pulseaudio",
    "network",
    "temperature",
    "cpu",
    "memory",
    "custom/power"
  ],
  "hyprland/workspaces": {
    "format": "[{id}]",
    "on-click": "activate"
  },
  "hyprland/window": {
    "max-length": 50
  },
  "tray": {
    "hide-if-empty": true
  },
  "clock": {
    "format-alt": "{:%a, %d. %b  %H:%M}"
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "<span size='18000' rise='-2000'></span>",
      "deactivated": "<span size='18000' rise='-2000'></span>"
    },
    "on-click-right": "hyprlock"
  },
  "pulseaudio": {
    "format": "<span size='18000' rise='-2000'></span> {volume}%",
    // "format": " {volume}%",
    "format-muted": " Muted"
  },
  "network": {
    "format-ethernet": "<span size='18000' rise='-2000'></span> {ifname} {ipaddr}",
    "format-disconnected": "<span size='18000' rise='-2000'></span> Disconnected",
    "format-error": "<span size='18000' rise='-2000'>󰍛</span> Error"
  },
  "temperature": {
    // "thermal-zone": 2,
    "thermal-zone": 1,
    "format": "{temperatureC}°C",
    "max": 80,
    "critical": 90
  },
  "cpu": {
    "format": "CPU: {usage}%"
  },
  "memory": {
    "format": "RAM: {used} GiB"
  },
  "custom/power": {
    "format": "<span size='18000' rise='-2000'></span>",
    "tooltip": "Power Menu",
    "on-click": "wlogout"
  }
}
